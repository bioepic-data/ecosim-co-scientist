{
  "mcpServers": {
    "ols-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "ols-mcp"
      ],
      "env": {}
    },
    "pubmed": {
      "type": "http",
      "url": "https://pubmed.mcp.claude.com/mcp"
    },
    "paper-search": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "paper-search-mcp",
        "python",
        "-m",
        "paper_search_mcp.server"
      ],
      "env": {}
    }
  }
}
